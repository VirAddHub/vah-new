# LOCAL DEVELOPMENT ONLY. Every value here is a dummy. Do not put real keys in this file's
# committed copy; `npm run local:setup` copies it to local/backend.env (git-ignored) for your own edits.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/vah_local
JWT_SECRET=local-dev-jwt-secret-not-for-production-0000000000
APP_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Background side effects off locally
SKIP_BOOT_SIDE_EFFECTS=1
HOURLY_EXPORTS_ENABLED=0
DISABLE_INVOICE_CLEANUP=1

# Rate limits stay ON by default (the journey must pass with them on).
# DISABLE_RATE_LIMIT=1

# Internal secrets (dummy)
MAIL_IMPORT_WEBHOOK_SECRET=local-mail-import-secret
INTERNAL_CRON_TOKEN=local-internal-cron-token
DAILY_SUMMARY_SECRET=local-daily-summary-secret
BILLING_CRON_SECRET=local-billing-cron-secret

# Billing: Stripe TEST mode only. Replace the dummies with your own sk_test_/pk_test_/whsec_ values
# in local/backend.env. Live keys (sk_live_) are refused by local/guard.sh.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_localdummy000000000000000000
STRIPE_PUBLISHABLE_KEY=pk_test_localdummy000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_localdummy000000000000000000
STRIPE_PRICE_ID_MONTHLY=price_localdummy_monthly
STRIPE_PRICE_ID_ANNUAL=price_localdummy_annual

# Sumsub: webhook secret lets signed test events be simulated locally. No API token = widget disabled.
SUMSUB_WEBHOOK_SECRET=local-sumsub-webhook-secret
POSTMARK_WEBHOOK_SECRET=local-postmark-webhook-secret

# Email: intentionally NOT configured. With no POSTMARK_TOKEN nothing is sent. Local tests use mocks.
# Companies House, Ideal Postcodes, OneDrive/Graph, Cloudinary: not configured locally.
